# =============================================================================
# Gini Enterprise AI - AWS Environment Configuration Template
# =============================================================================
# Used when running the NestJS Gateway and Workers against AWS cloud resources
# (Amazon ECS, Amazon RDS, Amazon OpenSearch, and AWS SageMaker AI).
# =============================================================================

NODE_ENV=development
APP_ENV=remote
PORT=3000

# AWS Region
AWS_REGION=us-east-1

# Amazon RDS PostgreSQL 16 (Credentials stored in AWS Secrets Manager)
DATABASE_URL=postgresql://pgadmin:<DB_ADMIN_PASSWORD>@psql-gini-ai-dev.cxxxxxx.us-east-1.rds.amazonaws.com:5432/ginidb

# Keycloak 24 (Deployed on Amazon ECS Fargate behind ALB)
KEYCLOAK_URL=https://auth.gini.ai
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<KEYCLOAK_ADMIN_PASSWORD>
KEYCLOAK_ADMIN_CLIENT_ID=gini-gateway-service
KEYCLOAK_ADMIN_CLIENT_SECRET=<KEYCLOAK_ADMIN_CLIENT_SECRET>

# Frontend Portal & Backoffice URLs (S3 + CloudFront CDN)
OEM_BACKOFFICE_URL=https://admin.gini.ai
ENTERPRISE_PORTAL_URL=https://portal.gini.ai

# CORS & Allowed Origins
ALLOWED_ORIGINS=https://portal.gini.ai,https://admin.gini.ai
CORS_ORIGINS=https://portal.gini.ai,https://admin.gini.ai

# Amazon ElastiCache for Redis / Valkey
REDIS_HOST=redis-gini-ai-dev.xxxxxx.0001.use1.cache.amazonaws.com

# Amazon OpenSearch Service (Managed Cluster Knowledge Base)
OPENSEARCH_NODE_URL=https://search-gini-ai-rag-dev-xxxxxx.us-east-1.es.amazonaws.com
OPENSEARCH_VECTOR_DIMENSION=1024

# AWS SageMaker AI Real-Time Endpoints
SAGEMAKER_LLM_ENDPOINT_NAME=gini-llm-reasoning-dev
SAGEMAKER_EMBEDDING_ENDPOINT_NAME=gini-embeddings-dev

# Amazon S3 Document Storage
RAG_DOCUMENTS_S3_BUCKET=gini-ai-rag-documents-dev-xxxxxx
