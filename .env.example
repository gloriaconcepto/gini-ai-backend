# Gini AI Backend Local Environment Variables
# Copy this file to .env and fill in your values for local development.

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://pgadmin:your_secure_password@localhost:5432/ginidb

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=gini-gateway-service
KEYCLOAK_ADMIN_CLIENT_SECRET=2AgTtNcnIpuojPM8OKzdH4pQ5kAk9PA3

# Redis
REDIS_HOST=localhost

# Document Storage & Downstream RAG Ingestion Pipeline
# Mode: "remote" (connects to live AWS S3 bucket & EventBridge pipeline) | "local" (in-memory mock storage)
DOCUMENT_STORAGE_MODE=remote
AWS_S3_BUCKET_NAME=gini-rag-documents-587546840220
AWS_S3_REGION=us-west-2
AWS_S3_PRESIGNED_EXPIRATION_SECONDS=900

# Optional: Explicit AWS IAM credentials for S3 Document Storage
# If omitted, the AWS SDK automatically resolves credentials via ~/.aws/credentials or IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

