{
  "realm": "master",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "gini-gateway-service",
      "name": "Gini AI Gateway Service Account",
      "description": "Confidential client for Gateway administrative access and multi-tenant management",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.KEYCLOAK_ADMIN_CLIENT_SECRET:2AgTtNcnIpuojPM8OKzdH4pQ5kAk9PA3}",
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "@gini/oem-backoffice",
      "name": "Gini AI OEM Backoffice SPA",
      "description": "Public SPA client for OEM Backoffice platform management",
      "rootUrl": "http://localhost:3002",
      "baseUrl": "http://localhost:3002",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3002/*"
      ],
      "webOrigins": [
        "http://localhost:3002",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3002/*##+"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@gini.local",
      "credentials": [
        {
          "type": "password",
          "value": "${env.KEYCLOAK_ADMIN_PASSWORD:admin}",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "service-account-gini-gateway-service",
      "enabled": true,
      "serviceAccountClientId": "gini-gateway-service",
      "realmRoles": ["admin"]
    }
  ]
}
