# Example AWS Terraform variables
aws_region                       = "us-west-2"
project_name                     = "gini-ai"
environment                      = "dev"
vpc_cidr                         = "10.0.0.0/16"

# Master Database Credentials
db_admin_username                = "pgadmin"
db_admin_password                = "zigqiz-dafbir-gyqGi8"

# Keycloak Credentials
keycloak_admin_username          = "admin"
keycloak_admin_password          = "zigqiz-dafbir-gyqGi8"
keycloak_admin_client_secret     = "zigqiz-dafbir-gyqGi8"

# External RAG Document Storage (Provisioned in standalone RAG repo)
s3_document_bucket_name          = "gini-rag-documents"

# Optional CORS Origins
cors_origins                     = "https://portal.gini.ai,https://admin.gini.ai"
